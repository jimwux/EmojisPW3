@model List<PW3.Emoji.Entidades.EF.AnalisisResultado>

@{
    ViewData["Title"] = "Listado de Análisis";
    var paginaActual = ViewBag.PaginaActual as int? ?? 1;
    var emociones = ViewBag.Emociones as List<PW3.Emoji.Entidades.EF.Emocion> ?? new List<PW3.Emoji.Entidades.EF.Emocion>();
    int? emocionFilter = ViewBag.EmocionFilter as int?;
    DateTime? fechaDesde = ViewBag.FechaDesde as DateTime?;
    DateTime? fechaHasta = ViewBag.FechaHasta as DateTime?;
    bool esAdmin = ViewBag.EsAdmin as bool? ?? false;
    var usuarios = ViewBag.Usuarios as List<PW3.Emoji.Entidades.EF.Usuario> ?? new List<PW3.Emoji.Entidades.EF.Usuario>();
    int? usuarioFilter = ViewBag.UsuarioFilter as int?;
}

<h2>Listado de Análisis</h2>

<form method="get" asp-action="ListarAnalisis" class="mb-3">
    <div class="row">
        <div class="col-md-3">
            <label for="emocionFilter" class="form-label">Emoción</label>
            <select id="emocionFilter" name="emocionFilter" class="form-select">
                <option value="">Todas</option>
                @foreach (var emocion in emociones)
                {
                    <option value="@emocion.Id" selected="@(emocionFilter == emocion.Id)">@emocion.Descripcion</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label for="fechaDesde" class="form-label">Fecha desde</label>
            <input type="date" id="fechaDesde" name="fechaDesde" class="form-control" value="@(fechaDesde?.ToString("yyyy-MM-dd") ?? "")" />
        </div>
        <div class="col-md-3">
            <label for="fechaHasta" class="form-label">Fecha hasta</label>
            <input type="date" id="fechaHasta" name="fechaHasta" class="form-control" value="@(fechaHasta?.ToString("yyyy-MM-dd") ?? "")" />
        </div>
        @if (esAdmin)
        {
            <div class="col-md-3">
                <label for="usuarioFilter" class="form-label">Usuario</label>
                <select id="usuarioFilter" name="usuarioFilter" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var usuario in usuarios)
                    {
                        <option value="@usuario.Id" selected="@(usuarioFilter == usuario.Id)">@usuario.Nombre</option>
                    }
                </select>
            </div>
        }
        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">Filtrar</button>
        </div>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Fecha de Análisis</th>
            <th>Emoción</th>
            <th>Usuario</th>
            <th>Confianza</th>
            <th>Imagen</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var analisis in Model)
        {
            <tr>
                <td>@analisis.FechaAnalisis.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@analisis.Emocion?.Descripcion</td>
                <td>@analisis.Usuario?.Nombre</td>
                <td>@analisis.Confianza.ToString("P2")</td>
                <td>
                    @if (analisis.Imagen != null && !string.IsNullOrEmpty(analisis.Imagen.Ruta))
                    {
                        <img src="@analisis.Imagen.Ruta" alt="Imagen" width="60" />
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    @{
        var estiloDeshabilitado = paginaActual <= 1 ? "pointer-events: none; opacity: 0.5;" : "";
    }
    <a asp-action="ListarAnalisis"
       asp-route-emocionFilter="@emocionFilter"
       asp-route-fechaDesde="@(fechaDesde?.ToString("yyyy-MM-dd"))"
       asp-route-fechaHasta="@(fechaHasta?.ToString("yyyy-MM-dd"))"
       asp-route-pagina="@(paginaActual - 1)"
       class="btn btn-secondary"
       style="@estiloDeshabilitado">Anterior</a>
    <span>Página @paginaActual</span>
    <a asp-action="ListarAnalisis"
       asp-route-emocionFilter="@emocionFilter"
       asp-route-fechaDesde="@(fechaDesde?.ToString("yyyy-MM-dd"))"
       asp-route-fechaHasta="@(fechaHasta?.ToString("yyyy-MM-dd"))"
       asp-route-pagina="@(paginaActual + 1)"
       class="btn btn-secondary">Siguiente</a>
</div>