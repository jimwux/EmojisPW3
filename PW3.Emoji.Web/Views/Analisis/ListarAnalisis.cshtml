@model List<PW3.Emoji.Entidades.EF.AnalisisResultado>

@{
    ViewData["Title"] = "Listado de Análisis";
    var nombreUsuario = ViewBag.NombreUsuario as string ?? "Usuario";
    bool esAdmin = ViewBag.EsAdmin as bool? ?? false;
    var emociones = ViewBag.Emociones as List<PW3.Emoji.Entidades.EF.Emocion> ?? new();
    var usuarios = ViewBag.Usuarios as List<PW3.Emoji.Entidades.EF.Usuario> ?? new();
    int? emocionFilter = ViewBag.EmocionFilter as int?;
    int? usuarioFilter = ViewBag.UsuarioFilter as int?;
    DateTime? fechaDesde = ViewBag.FechaDesde as DateTime?;
    DateTime? fechaHasta = ViewBag.FechaHasta as DateTime?;
    var paginaActual = ViewBag.PaginaActual as int? ?? 1;
}

<div class="listado-analisis-wrapper">
    <!-- HEADER -->
    <div class="listado-header">
        <span class="emoji me-2">🤗</span>
        <span>¡Hola @nombreUsuario!</span>
    </div>

    @if (esAdmin)
    {
        <h3 class="titulo-analisis">Listado de análisis</h3>
    }
    else
    {
        <h3 class="titulo-analisis">Tus análisis</h3>
    }

    <!-- FILTROS -->
    <form method="get" asp-action="ListarAnalisis" class="filtros-analisis">

        @if (esAdmin)
        {
            <div class="busqueda-usuario mb-3">
                <select id="usuarioFilter" name="usuarioFilter" class="form-select">
                    <option value="">
                        <i class="fa-solid fa-user text-warning"></i>
                        Todos los usuarios
                    </option>
                    @foreach (var usuario in usuarios)
                    {
                        <option value="@usuario.Id" selected="@(usuarioFilter == usuario.Id)">
                            @usuario.Nombre
                        </option>
                    }
                </select>
            </div>
        }

        <div class="filtros-row">
            <input type="date" id="fechaDesde" name="fechaDesde"
                   value="@(fechaDesde?.ToString("yyyy-MM-dd"))"
                   class="form-control" placeholder="Fecha desde" />

            <input type="date" id="fechaHasta" name="fechaHasta"
                   value="@(fechaHasta?.ToString("yyyy-MM-dd"))"
                   class="form-control" placeholder="Fecha hasta" />

            <select id="emocionFilter" name="emocionFilter" class="form-select">
                <option value="">Todas las emociones</option>
                @foreach (var emocion in emociones)
                {
                    <option value="@emocion.Id" selected="@(emocionFilter == emocion.Id)">
                        @emocion.Descripcion
                    </option>
                }
            </select>

            <!-- Nuevo select visual -->
            <select id="orden" name="orden" class="form-select">
                <option value="nuevos">Más nuevos</option>
                <option value="antiguos">Más antiguos</option>
            </select>

            <button type="submit" class="btn-filtrar">
                <i class="fa-solid fa-magnifying-glass me-2"></i> Filtrar
            </button>
        </div>
    </form>

    <!-- LISTADO -->
    <div class="analisis-tabla">
        <div class="analisis-header-row">
            <span class="text-start ms-2">Imagen</span>
            @if (esAdmin)
            {
                <span class="text-start ms-2">Usuario</span>
            }
            <span>Fecha de realización</span>
            <span>Emoción obtenida</span>
            <span>Confianza</span>
            <span class="text-end me-2">Emoji</span>
        </div>

        @if (Model.Any())
        {
            @foreach (var analisis in Model)
            {
                <div class="analisis-item">
                    <div class="analisis-col imagen ms-2">
                        <img src="@analisis.Imagen?.Ruta" alt="Imagen" />
                    </div>
                    @if (esAdmin)
                    {
                        <div class="analisis-col usuario">
                            @analisis.Usuario?.Nombre
                        </div>
                    }
                    <div class="analisis-col fecha">
                        @analisis.FechaAnalisis.ToString("dd/MM/yyyy")
                    </div>
                    <div class="analisis-col emocion">
                        @analisis.Emocion?.Descripcion
                    </div>
                    <div class="analisis-col confianza">
                        @analisis.Confianza.ToString("P2")
                    </div>
                    <div class="analisis-col emoji me-2">
                        <img src="@Url.Content($"~/assets/emotions/{analisis.Emocion?.Nombre}.svg")" alt="Emoji emoción" />
                    </div>
                </div>
            }
        }
        else
        {
            <p class="sin-resultados">
                No se encontraron análisis para los filtros seleccionados.
            </p>
        }
    </div>

    <!-- PAGINACIÓN -->
    <div class="paginacion">
        @{
            var prevDisabled = paginaActual <= 1 ? "disabled" : "";
        }

        <a asp-action="ListarAnalisis"
           asp-route-emocionFilter="@emocionFilter"
           asp-route-fechaDesde="@(fechaDesde?.ToString("yyyy-MM-dd"))"
           asp-route-fechaHasta="@(fechaHasta?.ToString("yyyy-MM-dd"))"
           asp-route-pagina="@(paginaActual - 1)"
           class="btn @prevDisabled">
            <i class="fa-solid fa-chevron-left"></i>
        </a>

        <span class="activo">@paginaActual</span>

        <a asp-action="ListarAnalisis"
           asp-route-emocionFilter="@emocionFilter"
           asp-route-fechaDesde="@(fechaDesde?.ToString("yyyy-MM-dd"))"
           asp-route-fechaHasta="@(fechaHasta?.ToString("yyyy-MM-dd"))"
           asp-route-pagina="@(paginaActual + 1)"
           class="btn">
            <i class="fa-solid fa-chevron-right"></i>
        </a>
    </div>
</div>
