@{
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="login-container mt-5">
    <div class="login-card">
        <div class="login-header-img">
            <img src="~/assets/img/label-iniciar-sesion.png" alt="Iniciar sesión" />
        </div>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">
                @TempData["Mensaje"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <form asp-action="Login" method="post">
            <div class="form-group">
                <label for="email">Correo electrónico</label>
                <input name="email" type="email" class="form-control" placeholder="Ingresar correo electrónico" required />
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <input name="password" type="password" class="form-control" placeholder="Ingresar contraseña" required />
            </div>

            <button type="submit" class="btn-continuar">Continuar</button>
        </form>

        <div class="extra-links">
            <a asp-controller="Usuario" asp-action="Registro" class="link-registro">¿No tenés cuenta? Registrate</a>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="text-danger mt-3">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }
    </div>
</div>
