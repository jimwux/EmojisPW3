@{
    ViewData["Title"] = "Resultado del Análisis";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<div class="analisis-wrapper">
    <div class="analisis-container">

        <!-- Columna izquierda -->
        <div class="resultado-texto">
            <h2>Tu emoción es...</h2>
            <div class="emocion">¡@ViewBag.Emocion!</div>
            @if (ViewBag.Confidence != null)
            {
                <p class="confidence">Confianza: @((ViewBag.Confidence).ToString("P2"))</p>
            }
            <a asp-action="Analizar" class="btn-analizar" style="margin-top:2rem;">
                <img src="~/assets/icons/emoji-pensando.svg" alt="Analizar otra imagen" />
                Analizar otra imagen
            </a>
        </div>

        <!-- Columna derecha -->
        <div class="resultado-imagen">
            <div class="resultado-circulo">
                @if (ViewBag.ImagenRuta != null)
                {
                    <img src="@ViewBag.ImagenRuta" alt="Imagen analizada" />
                }
                <img src="~/assets/emotions/@ViewBag.EmocionSvg" class="emoji-overlay" alt="Emoji emoción" />
            </div>
        </div>
    </div>
</div>
